/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "useDefineForClassFields": false,
    "paths": {
      "@shoppers-point/auth-state": ["./src/app/auth-state/index.ts"],
      "@shoppers-point/cart-state": ["./src/app/cart-state/index.ts"],
      "@shoppers-point/catalogue-state": ["./src/app/catalogue-state/index.ts"],
      "@shoppers-point/checkout-state": ["./src/app/checkout-state/index.ts"],
      "@shoppers-point/contact-state": ["./src/app/contact-state/index.ts"],
      "@shoppers-point/error-state": ["./src/app/error-state/index.ts"],
      "@shoppers-point/progress-state": ["./src/app/progress-state/index.ts"],
      "@shoppers-point/user-state": ["./src/app/user-state/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
